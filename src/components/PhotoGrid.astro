---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import { excerpt, formatDate } from '../lib/blog';
import { largeImage, photoName, photoUrl, type Album, type Photo } from '../lib/photos';

interface Props {
  album: Album;
  photos: Photo[];
}

const { album, photos } = Astro.props;

const items = await Promise.all(
  photos.map(async (photo) => {
    const { image, text } = photo.data;
    const { Content } = await render(photo);
    // Short notes fit under the photo in the lightbox; longer ones (or more than a paragraph) get the start
    // and a link to the photo's page.
    const long = !!text && (excerpt(text, 100).endsWith('…') || /\n\s*\n/.test(text.trim()));
    const short = long ? excerpt(text, 50) : '';
    return { photo, ratio: image.width / image.height, large: await largeImage(photo), Content, short, long };
  }),
);
---

<div data-gallery data-album-url={Astro.url.pathname}>
  <div class="gallery">
    {items.map(({ photo, ratio, large, Content, short, long }) => (
      <figure class="photo" style={`--r: ${ratio.toFixed(4)}`}>
        <a href={photoUrl(photo)} data-src={large.src} data-srcset={large.srcSet.attribute}>
          <Image
            src={photo.data.image}
            alt={photoName(photo, album)}
            width={Math.min(photo.data.image.width, 960)}
            widths={[480, 960, 1440]}
            sizes={`(max-width: 640px) ${Math.round(240 * ratio)}px, ${Math.round(400 * ratio)}px`}
          />
        </a>
        {/* Shown in the lightbox. */}
        <figcaption hidden>
          {photo.data.title && <strong>{photo.data.title}</strong>}
          {(photo.data.place || photo.data.date || photo.data.gear) && (
            <span class="meta">
              {photo.data.place && <span>{photo.data.place}</span>}
              {photo.data.date && <time datetime={photo.data.date.toISOString()}>{formatDate(photo.data.date)}</time>}
              {photo.data.gear && <span>{photo.data.gear}</span>}
            </span>
          )}
          {long ? (
            <p class="text">{short} <a href={photoUrl(photo)}>閱讀全文 →</a></p>
          ) : (
            photo.data.text && <div class="text"><Content /></div>
          )}
        </figcaption>
      </figure>
    ))}
  </div>

  <dialog class="lightbox" aria-label="照片">
    <div class="bar">
      <span class="count"></span>
      <button class="close" type="button" aria-label="關閉" autofocus>✕</button>
    </div>
    <div class="stage">
      <div class="frame"></div>
      <div class="caption"></div>
    </div>
    <button class="step prev" type="button" aria-label="上一張">‹</button>
    <button class="step next" type="button" aria-label="下一張">›</button>
  </dialog>
</div>

<style>
  /* Justified rows: each photo's width follows its aspect ratio (--r), so a row shares one height. */
  .gallery {
    --row: 240px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  /* Takes up the slack in the last row, so its photos keep their size instead of stretching. */
  .gallery::after { content: ''; flex-grow: 1000000; }

  .photo {
    flex: var(--r) 1 calc(var(--row) * var(--r));
    margin: 0;
    overflow: hidden;
    border-radius: 8px;
    background: var(--line);
  }
  .photo a { display: block; }
  .photo img { width: 100%; height: auto; }
  @media (prefers-reduced-motion: no-preference) {
    .photo img { transition: transform 0.4s ease; }
    .photo a:hover img { transform: scale(1.03); }
  }

  @media (max-width: 640px) {
    .gallery { --row: 140px; gap: 4px; }
    .photo { border-radius: 4px; }
  }

  /* Lightbox: dark whatever the theme, so the photo stands out. */
  .lightbox {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #0c0d10;
    color: #c9ced6;
  }
  .lightbox[open] { display: flex; flex-direction: column; }
  .lightbox::backdrop { background: transparent; }
  :global(html:has(.lightbox[open])) { overflow: hidden; }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 12px 10px 20px;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }

  button {
    border: 0;
    border-radius: 10px;
    background: rgb(255 255 255 / 0.08);
    color: #fff;
    font: inherit;
    line-height: 1;
    cursor: pointer;
  }
  button:hover { background: rgb(255 255 255 / 0.16); }
  .close { width: 40px; height: 40px; font-size: 18px; }

  .stage {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 0;
    padding: 0 72px 24px;
  }
  /* Sized from the aspect ratio up front, so the box is right before the image arrives. */
  .frame {
    width: min(100%, calc(max(100dvh - 210px, 50dvh) * var(--r)));
    aspect-ratio: var(--r);
  }
  .frame :global(img) {
    width: 100%;
    height: 100%;
    /* The thumbnail, already loaded, fills in until the large image does. */
    background: center / cover no-repeat;
  }

  .caption {
    max-width: 40em;
    margin-top: 14px;
    font-size: 14px;
    line-height: 1.6;
    text-align: center;
  }
  .caption strong { display: block; color: #fff; font-size: 16px; font-weight: 600; }
  .meta { display: flex; flex-wrap: wrap; justify-content: center; gap: 0 14px; color: #8f96a3; }
  .text { margin: 6px 0 0; }
  .text :global(p) { margin: 0; }
  .text :global(p + p) { margin-top: 0.5em; }
  .text :global(a) { color: #8fb0ff; }

  .step {
    position: absolute;
    top: 50%;
    width: 48px;
    height: 72px;
    font-size: 32px;
    translate: 0 -50%;
  }
  .prev { left: 12px; }
  .next { right: 12px; }

  /* Phones: the photo takes the full width; swipe to move, or tap the arrows over it. */
  @media (max-width: 640px) {
    .stage { padding: 0 0 20px; }
    .caption { padding: 0 20px; }
    .step { width: 36px; height: 56px; font-size: 26px; background: rgb(0 0 0 / 0.35); }
    .prev { left: 6px; }
    .next { right: 6px; }
  }
</style>

<script>
  // Thumbnails link to each photo's page, so they work without JavaScript; with it they open in this lightbox.
  for (const root of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const photos = [...root.querySelectorAll<HTMLElement>('.photo')];
    const dialog = root.querySelector('dialog')!;
    const frame = dialog.querySelector<HTMLElement>('.frame')!;
    const caption = dialog.querySelector<HTMLElement>('.caption')!;
    const count = dialog.querySelector<HTMLElement>('.count')!;
    let current = 0;

    // The large image for photo i, picked for the size it will be shown at.
    const large = (i: number) => {
      const photo = photos[i];
      const link = photo.querySelector(':scope > a')!;
      const ratio = parseFloat(photo.style.getPropertyValue('--r'));
      const img = new Image();
      img.sizes = `${Math.ceil(Math.min(innerWidth, Math.max(innerHeight - 210, innerHeight / 2) * ratio))}px`;
      img.srcset = link.dataset.srcset ?? '';
      img.src = link.dataset.src ?? '';
      return img;
    };

    function show(i: number) {
      current = (i + photos.length) % photos.length;
      const photo = photos[current];
      const thumb = photo.querySelector(':scope > a > img')!;

      // A new <img> every time: reusing one would show the previous photo, stretched, until the next loads.
      const img = large(current);
      img.alt = thumb.alt;
      img.style.backgroundImage = `url("${thumb.currentSrc || thumb.src}")`;
      frame.style.setProperty('--r', photo.style.getPropertyValue('--r'));
      frame.replaceChildren(img);
      caption.replaceChildren(...[...photo.querySelector('figcaption')!.childNodes].map((n) => n.cloneNode(true)));
      count.textContent = `${current + 1} / ${photos.length}`;

      // The address is the photo's own page, so it can be shared or reopened.
      history.replaceState(null, '', photo.querySelector<HTMLAnchorElement>(':scope > a')!.href);
      if (!dialog.open) dialog.showModal();

      // Warm up the neighbours, so stepping through doesn't wait.
      if (photos.length > 1) [current + 1, current - 1].forEach((j) => large((j + photos.length) % photos.length));
    }

    photos.forEach((photo, i) => {
      photo.querySelector(':scope > a')!.addEventListener('click', (e) => {
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        show(i);
      });
    });

    const prev = dialog.querySelector<HTMLButtonElement>('.prev')!;
    const next = dialog.querySelector<HTMLButtonElement>('.next')!;
    prev.hidden = next.hidden = photos.length < 2;
    prev.addEventListener('click', () => show(current - 1));
    next.addEventListener('click', () => show(current + 1));
    dialog.querySelector('.close')!.addEventListener('click', () => dialog.close());

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });

    // Clicking the dark area around the photo closes it.
    dialog.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target === dialog || target.classList.contains('stage') || target.classList.contains('bar')) dialog.close();
    });

    // Swipe left or right with one finger; pinch-zooming doesn't count.
    let startX = 0;
    let startY = 0;
    let pinched = false;
    dialog.addEventListener('touchstart', (e) => {
      pinched = e.touches.length > 1;
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
    }, { passive: true });
    dialog.addEventListener('touchmove', (e) => {
      if (e.touches.length > 1) pinched = true;
    }, { passive: true });
    dialog.addEventListener('touchend', (e) => {
      if (pinched || e.touches.length > 0 || photos.length < 2) return;
      const dx = e.changedTouches[0].clientX - startX;
      const dy = e.changedTouches[0].clientY - startY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) show(current + (dx < 0 ? 1 : -1));
    });

    dialog.addEventListener('close', () => history.replaceState(null, '', root.dataset.albumUrl));
  }
</script>
