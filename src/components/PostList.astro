---
import { formatDate, postUrl, summary, tagUrl, type Post } from '../lib/blog';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="posts panel">
  {posts.map((post) => (
    <li>
      <h3>
        <a href={postUrl(post)}>{post.data.title}</a>
        {post.data.draft && <span class="draft">草稿</span>}
      </h3>
      <p class="summary">{summary(post)}</p>
      <p class="meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {post.data.tags.map((tag) => <a class="tag" href={tagUrl(tag)}>#{tag}</a>)}
      </p>
    </li>
  ))}
</ul>

<style>
  .posts { margin: 0; padding: 0; list-style: none; }
  li { padding: 18px 22px; }
  li + li { border-top: 1px solid var(--line); }

  h3 { margin: 0; font-size: 18px; line-height: 1.4; }
  h3 a { color: var(--text); text-decoration: none; }
  h3 a:hover { color: var(--accent); }

  .summary { margin: 4px 0 0; color: var(--muted); font-size: 15px; }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 13px;
  }
  .tag { color: var(--muted); text-decoration: none; }
  .tag:hover { color: var(--accent); }

  .draft {
    margin-left: 8px;
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 12px;
    font-weight: 500;
    vertical-align: 2px;
  }
</style>
