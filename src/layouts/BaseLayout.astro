---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  // Preview image when the page is shared, e.g. a photo.
  image?: string;
}

const { title, description, type = 'website', image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const path = Astro.url.pathname;
const nav = [
  { href: '/', label: '關於', current: path === '/' },
  { href: '/photos/', label: '相簿', current: path.startsWith('/photos/') },
  { href: '/tools/', label: '工具', current: path.startsWith('/tools/') },
  { href: '/blog/', label: '文章', current: path.startsWith('/blog/') },
];
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f5f6f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111317" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    {image && <meta name="twitter:card" content="summary_large_image" />}
    <link rel="alternate" type="application/rss+xml" title="mason276752 的文章" href="/blog/rss.xml" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/">
          <img src="/favicon.svg" alt="" width="24" height="24" />
          <span>mason276752</span>
        </a>
        <nav>
          {nav.map((n) => <a href={n.href} aria-current={n.current ? 'page' : undefined}>{n.label}</a>)}
          <a href="https://github.com/mason276752">GitHub</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>
          © {new Date().getFullYear()} mason276752 · 以 <a href="https://astro.build/">Astro</a> 建置 · <a
            href="https://github.com/mason276752/mason276752.github.io">原始碼</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header { border-bottom: 1px solid var(--line); }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }
  nav { display: flex; gap: 20px; }
  nav a { color: var(--muted); font-size: 14px; text-decoration: none; }
  nav a:hover, nav a[aria-current] { color: var(--text); }

  /* Room for all the links on a phone: keep just the icon. */
  @media (max-width: 480px) {
    .brand span { display: none; }
    nav { gap: 16px; }
  }

  main { padding: 48px 0 64px; }

  .site-footer {
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 13px;
  }
  .site-footer p { margin: 0; padding: 24px 0; }
  .site-footer a { color: inherit; }
</style>
