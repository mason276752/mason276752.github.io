---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { editUrl, formatDate, getPosts, summary, tagUrl, type Post } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, date, updated, tags, draft } = post.data;
const { Content } = await render(post);
---

<BaseLayout title={`${title} – mason276752`} description={summary(post)} type="article">
  <article class="wrap narrow">
    <a class="back" href="/blog/">← 所有文章</a>

    <header>
      <h1>{title}{draft && <span class="draft">草稿</span>}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <span>更新於 <time datetime={updated.toISOString()}>{formatDate(updated)}</time></span>}
        {tags.map((tag) => <a href={tagUrl(tag)}>#{tag}</a>)}
      </p>
    </header>

    <div class="prose"><Content /></div>

    <footer>
      <a href="/blog/">← 所有文章</a>
      <a href={editUrl(post)}>在 GitHub 上編輯</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .narrow { max-width: 760px; }

  .back, footer a { color: var(--muted); font-size: 14px; text-decoration: none; }
  .back:hover, footer a:hover { color: var(--accent); }

  header { margin: 8px 0 32px; }
  h1 { margin: 0; font-size: clamp(28px, 5vw, 36px); line-height: 1.3; letter-spacing: -0.01em; }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 14px; margin: 10px 0 0; color: var(--muted); font-size: 14px; }
  .meta a { color: inherit; text-decoration: none; }
  .meta a:hover { color: var(--accent); }

  .draft {
    margin-left: 10px;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0;
    vertical-align: 6px;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 16px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
</style>
