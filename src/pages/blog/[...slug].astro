---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { editUrl, formatDate, getPosts, summary, tagUrl, type Post } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, date, updated, tags, draft } = post.data;
const { Content } = await render(post);
---

<BaseLayout title={`${title} – mason276752`} description={summary(post)} type="article">
  <article class="wrap narrow">
    <a class="back" href="/blog/">← 所有文章</a>

    <header>
      <h1>{title}{draft && <span class="draft">草稿</span>}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <span>更新於 <time datetime={updated.toISOString()}>{formatDate(updated)}</time></span>}
        {tags.map((tag) => <a href={tagUrl(tag)}>#{tag}</a>)}
      </p>
    </header>

    <div class="prose"><Content /></div>

    <footer>
      <a href="/blog/">← 所有文章</a>
      <a href={editUrl(post)}>在 GitHub 上編輯</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .narrow { max-width: 760px; }

  .back, footer a { color: var(--muted); font-size: 14px; text-decoration: none; }
  .back:hover, footer a:hover { color: var(--accent); }

  header { margin: 8px 0 32px; }
  h1 { margin: 0; font-size: clamp(28px, 5vw, 36px); line-height: 1.3; letter-spacing: -0.01em; }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 14px; margin: 10px 0 0; color: var(--muted); font-size: 14px; }
  .meta a { color: inherit; text-decoration: none; }
  .meta a:hover { color: var(--accent); }

  .draft {
    margin-left: 10px;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0;
    vertical-align: 6px;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 16px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  /* Post body: elements come from Markdown, so they need :global. */
  .prose { font-size: 17px; line-height: 1.85; overflow-wrap: break-word; }
  .prose > :global(:first-child) { margin-top: 0; }
  .prose :global(:is(p, ul, ol, blockquote, pre, table, figure, hr)) { margin: 0 0 1.2em; }
  .prose :global(:is(h2, h3, h4)) { margin: 2em 0 0.6em; line-height: 1.4; scroll-margin-top: 16px; }
  .prose :global(h2) { font-size: 1.45em; }
  .prose :global(h3) { font-size: 1.2em; }
  .prose :global(h4) { font-size: 1em; }
  .prose :global(:is(ul, ol)) { padding-left: 1.5em; }
  .prose :global(li + li) { margin-top: 0.3em; }
  .prose :global(li > :is(ul, ol)) { margin: 0.3em 0 0; }
  .prose :global(img) { height: auto; margin: 0 auto; border-radius: 10px; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--line); margin: 2.4em 0; }

  .prose :global(blockquote) {
    padding: 0.2em 0 0.2em 1em;
    border-left: 3px solid var(--line);
    color: var(--muted);
  }
  .prose :global(blockquote > :last-child) { margin-bottom: 0; }

  .prose :global(:not(pre) > code) {
    padding: 0.15em 0.4em;
    border-radius: 6px;
    background: var(--accent-soft);
    font-size: 0.88em;
  }
  .prose :global(:is(code, pre)) { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .prose :global(pre) {
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: 10px;
    font-size: 14px;
    line-height: 1.6;
    overflow-x: auto;
  }

  .prose :global(table) { display: block; max-width: 100%; border-collapse: collapse; font-size: 15px; overflow-x: auto; }
  .prose :global(:is(th, td)) { padding: 8px 12px; border: 1px solid var(--line); text-align: left; }
  .prose :global(th) { background: var(--panel); }
</style>
