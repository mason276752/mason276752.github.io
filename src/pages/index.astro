---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AlbumCard from '../components/AlbumCard.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/blog';
import { getAlbums, getPhotosByAlbum } from '../lib/photos';
// The self-introduction is Markdown, so it can be edited online at /admin/ too.
import { Content as Intro, frontmatter as about } from '../content/about.md';

const albums = (await getAlbums()).slice(0, 3);
const photos = await getPhotosByAlbum();
const posts = (await getPosts()).slice(0, 3);

// Same order as the sections on /tools/.
const categories = ['files', 'finance', 'learn', 'gallery'];
const tools = (await getCollection('tools')).sort(
  (a, b) => categories.indexOf(a.data.category) - categories.indexOf(b.data.category) || a.data.order - b.data.order,
);
---

<BaseLayout title={`${about.name}（mason276752）｜${about.status}`} description={about.description}>
  <section class="wrap hero">
    <p class="status"><span class="dot" aria-hidden="true"></span>{about.status}</p>
    <h1>嗨，我是 {about.name}</h1>
    <div class="intro"><Intro /></div>
    <p class="actions">
      <a class="btn primary" href="/photos/">看作品集 →</a>
      <a class="btn" href="/blog/">讀文章</a>
      <a class="btn" href="https://github.com/mason276752">GitHub</a>
    </p>
  </section>

  {albums.length > 0 && (
    <section class="wrap" aria-labelledby="photos-heading">
      <header class="section-head">
        <h2 id="photos-heading">最新相簿</h2>
        <a href="/photos/">所有相簿 →</a>
      </header>
      <div class="albums">
        {albums.map((album) => <AlbumCard album={album} photos={photos.get(album.id) ?? []} />)}
      </div>
    </section>
  )}

  <section class="wrap" aria-labelledby="tools-heading">
    <header class="section-head">
      <h2 id="tools-heading">我做的小工具</h2>
      <a href="/tools/">介紹與說明 →</a>
    </header>
    <p class="lead">打開網頁就能用，免安裝、免註冊。處理檔案的工具都在瀏覽器裡執行，檔案不會上傳。</p>
    <ul class="apps">
      {tools.map((t) => (
        <li>
          <a href={t.data.url} title={t.data.tagline}>
            <img src={t.data.icon} alt="" width="48" height="48" loading="lazy" />
            <span>{t.data.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {posts.length > 0 && (
    <section class="wrap" aria-labelledby="posts-heading">
      <header class="section-head">
        <h2 id="posts-heading">最新文章</h2>
        <a href="/blog/">所有文章 →</a>
      </header>
      <PostList posts={posts} />
    </section>
  )}
</BaseLayout>

<style>
  .hero { margin-bottom: 64px; }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 16px;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 14px;
    font-weight: 500;
  }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
  @media (prefers-reduced-motion: no-preference) {
    .dot { animation: pulse 2.4s ease-in-out infinite; }
  }
  @keyframes pulse {
    50% { opacity: 0.35; }
  }

  .hero h1 {
    margin: 0 0 16px;
    font-size: clamp(30px, 6vw, 44px);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .intro { max-width: 36em; color: var(--muted); font-size: 17px; line-height: 1.8; }
  .intro :global(p) { margin: 0 0 0.8em; }
  .intro :global(strong) { color: var(--text); font-weight: 600; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; margin: 24px 0 0; }

  section + section { margin-top: 64px; }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }
  .section-head h2 { margin: 0; font-size: 22px; line-height: 1.3; }
  .section-head a { flex: none; font-size: 14px; text-decoration: none; }
  .lead { margin: -8px 0 20px; max-width: 40em; color: var(--muted); font-size: 15px; }

  .albums {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 20px;
  }

  /* Tools as an app-icon grid; the full write-ups are on /tools/. */
  .apps {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .apps a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    height: 100%;
    padding: 14px 6px 12px;
    border: 1px solid transparent;
    border-radius: var(--radius);
    color: var(--text);
    font-size: 13px;
    line-height: 1.35;
    text-align: center;
    text-decoration: none;
  }
  .apps a:hover { border-color: var(--line); background: var(--panel); }
  .apps img { border-radius: 12px; }
  @media (max-width: 640px) {
    .apps { grid-template-columns: repeat(auto-fill, minmax(80px, 1fr)); }
  }
</style>
