---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import { getAlbums, getPhotosByAlbum } from '../../lib/photos';

const albums = await getAlbums();
const photos = await getPhotosByAlbum();
---

<BaseLayout title="作品集 – mason276752" description="mason276752 的攝影作品：用相機記下的日常與旅途，包括在日本打工度假的日子。">
  <section class="wrap">
    <header class="head">
      <h1>作品集</h1>
      <p>用相機記下的日常與旅途。每個相簿是一段旅程或一個主題，點進去看照片和背後的故事。</p>
    </header>

    {albums.length > 0 ? (
      <div class="grid">
        {albums.map((album) => <AlbumCard album={album} photos={photos.get(album.id) ?? []} />)}
      </div>
    ) : (
      <p class="empty">照片整理中，很快就會放上來。</p>
    )}
  </section>
</BaseLayout>

<style>
  .head { margin-bottom: 28px; }
  h1 { margin: 0 0 8px; font-size: clamp(28px, 5vw, 36px); line-height: 1.2; }
  .head p { margin: 0; max-width: 40em; color: var(--muted); font-size: 15px; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 20px;
  }
  .empty { color: var(--muted); }
</style>
